{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metamcp.org/schemas/method-v1alpha1.schema.json",
  "title": "MetaMCP Method v1alpha1",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "metamcp.io/v1alpha1" },
    "kind": { "const": "Method" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["effects", "inputSchema", "steps"],
      "additionalProperties": false,
      "properties": {
        "effects": { "enum": ["read", "write", "mixed"] },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "output": {},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "server", "tool"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "server": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "args": {},
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "idempotency": { "enum": ["safe", "unsafe"] },
        "onError": { "enum": ["fail", "gap"] },
        "retry": {
          "type": "object",
          "required": ["maxAttempts"],
          "additionalProperties": false,
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 2, "maximum": 5 },
            "backoffMs": { "type": "integer", "minimum": 0, "maximum": 30000 }
          }
        },
        "poll": {
          "type": "object",
          "required": ["path", "equals", "maxAttempts"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "equals": {},
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 100 },
            "intervalMs": { "type": "integer", "minimum": 0, "maximum": 30000 }
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["retry"] },
          "then": { "properties": { "idempotency": { "const": "safe" } }, "required": ["idempotency"] }
        },
        {
          "if": { "required": ["poll"] },
          "then": { "properties": { "idempotency": { "const": "safe" } }, "required": ["idempotency"] }
        }
      ]
    }
  }
}
